{
  "extends": "./tsconfig.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "compilerOptions": {
    "composite": false,
    "types": ["node"],
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  }
}
